# Copy this file to the repository root as .env.provisioner.
# Use a dedicated MySQL administrator account with CREATE DATABASE, CREATE USER,
# and GRANT OPTION privileges. Do not use the application's runtime account.
DB_PROVISIONER_ADMIN_HOST=192.0.2.10
DB_PROVISIONER_ADMIN_PORT=3306
DB_PROVISIONER_ADMIN_USER=replace-with-database-admin
DB_PROVISIONER_ADMIN_PASSWORD=replace-with-secret
# Trusted CA certificate used to verify the MySQL server.
# Multiline values can be encoded with literal \n sequences.
DB_PROVISIONER_SSL_CA=

# Restrict this to the private host/subnet where the app's database gateway runs.
# Example syntax: 10.10.99.%
DB_PROVISIONER_APP_HOST=192.0.2.%

# Optional if the gateway uses a different database address or port.
DB_PROVISIONER_APP_DB_HOST=192.0.2.10
DB_PROVISIONER_APP_DB_PORT=3306

# Optional only when the app database uses a different trusted CA.
DB_PROVISIONER_APP_SSL_CA=
